# ============================================================================
# Attendance Management System - Frontend Environment Variables
# ============================================================================
# Copy this file to .env or .env.local and update with your API URL.
# ============================================================================

# API Backend URL
# =============
# Development (local): Use /api which is proxied by Vite to http://localhost:8000
# VITE_API_URL=/api

# Or specify the full backend URL:
# - Local: http://localhost:8000
# - Remote: https://your-backend.render.com
# 
# Example values:
# VITE_API_URL=http://localhost:8000          # Local development
# VITE_API_URL=https://api.render.com         # Remote backend on Render
# VITE_API_URL=https://backend.example.com    # Any backend URL

# For local development with Vite proxy
VITE_API_URL=http://localhost:8000

# For production deployment on Vercel, use the Render backend URL
# VITE_API_URL=https://your-project-backend.onrender.com

# ============================================================================
# DEVELOPMENT SETUP
# ============================================================================
# 
# 1. Copy this file to .env.local
# 2. Update VITE_API_URL to match your backend URL
# 3. Run: npm install && npm run dev
# 4. Access at: http://localhost:3000
# 
# ============================================================================
# PRODUCTION DEPLOYMENT (Vercel)
# ============================================================================
# 
# Set Environment Variables in Vercel Dashboard:
# 1. Go to your project settings
# 2. Navigate to Environment Variables
# 3. Add: VITE_API_URL = https://your-backend.onrender.com
# 4. Redeploy your project
# 
# ============================================================================
