# ============================================================================
# Attendance Management System - Backend Environment Variables
# ============================================================================
# Copy this file to .env and update with your production values.
# Never commit .env files containing secrets!
# ============================================================================

# DATABASE CONFIGURATION
# ============================================================================
# Development: Use SQLite for local development
DATABASE_URL=sqlite:///./attendance.db

# Production: Use PostgreSQL
# Example: postgresql+asyncpg://username:password@localhost:5432/attendance_db
# For Neon: postgresql+asyncpg://user:password@host/dbname?sslmode=require
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - Use a long, random string (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRITICAL: Change this in production!
SECRET_KEY=your-super-secret-jwt-key-change-in-production-use-generate-secret-key

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Device API Key - Used by fingerprint devices for authentication
# Generate a unique key for security
DEVICE_API_KEY=your-device-api-key-change-in-production

# Encryption Key - Must be exactly 32 characters for Fernet encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: This must be exactly 32 characters and the same across instances
ENCRYPTION_KEY=your-32-character-encryption-key!

# ADMIN CREDENTIALS
# ============================================================================
# Primary admin username and password
# These are used for the initial/default admin account
# CRITICAL: Change these in production!
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# FRONTEND CONFIGURATION
# ============================================================================
# URL of the frontend application (for CORS configuration)
# Development: http://localhost:3000
# Production: https://example.com (your Vercel frontend URL)
FRONTEND_URL=http://localhost:3000

# SERVER CONFIGURATION
# ============================================================================
# Server host and port
# For Render and cloud platforms: Use 0.0.0.0 and let platform provide PORT
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Application environment
# Values: development, staging, production
ENVIRONMENT=development

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# 
# For Render Deployment:
# 1. Create PostgreSQL database in Render console
# 2. Copy the Internal Database URL from Render
# 3. Set DATABASE_URL to the PostgreSQL URL
# 4. Generate a strong SECRET_KEY and DEVICE_API_KEY
# 5. Set ADMIN_PASSWORD to a strong password
# 6. Set FRONTEND_URL to your Vercel frontend URL
# 7. Add all these variables to Render Environment Variables
# 
# Example Render Environment Variables:
# - DATABASE_URL: postgresql+asyncpg://user:password@host:5432/dbname
# - SECRET_KEY: [generated secure key]
# - DEVICE_API_KEY: [generated secure key]
# - ADMIN_PASSWORD: [strong password]
# - FRONTEND_URL: https://your-frontend.vercel.app
# - SERVER_HOST: 0.0.0.0
# - ENVIRONMENT: production
# 
# Start Command on Render:
# uvicorn main:app --host 0.0.0.0 --port $PORT
#
# For Local Development:
# 1. Create a .env file in backend/ directory
# 2. Use SQLite for DATABASE_URL
# 3. Use default admin credentials
# 4. Run: python -m uvicorn main:app --reload
# 
# ============================================================================
